<!-- Add this script to get the correct appearance. Easier than changing CSS on all sites if you want to add the same solution in more places.
Bootstrap has a bug that makes Collapsible on TR become display:block instead of display:table-row as it should be -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const style = document.createElement('style');
    const css = '.tab-pane table tr.multi-collapse td { vertical-align: middle !important; } .tab-pane table td.br-transp { border-right-color: transparent !important; } .tab-pane table tr.show { display: table-row !important; }';
    if (style.styleSheet) {
      style.styleSheet.cssText = css;
    } else {
      style.appendChild(document.createTextNode(css));
    }
    document.head.appendChild(style);

    // Sync all group rows when first item is toggled
    document.querySelectorAll('a[data-toggle="collapse"][data-target^="#exTr_"]').forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var groupNum = this.getAttribute('data-target').replace('#exTr_', '');
        var isExpanded = this.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('tr.exGrp_' + groupNum).forEach(function(row) {
          if (isExpanded) {
            row.classList.remove('show');
          } else {
            row.classList.add('show');
          }
        });
      });
    });
  });
</script>

<?php if ($hideReserveDuplicates): ?>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Hide duplicate values in collapse rows
    document.querySelectorAll('tr.collapse').forEach(function(collapseRow) {
      // Find the parent main row (previous non-collapse, non-mobile-spacer tr)
      let mainRow = collapseRow.previousElementSibling;
      while (mainRow && (mainRow.classList.contains('collapse') || mainRow.classList.contains('mobile-spacer'))) {
        mainRow = mainRow.previousElementSibling;
      }
      if (mainRow) {
        // Compare department (works for both addPlacementColumn true and false)
        const mainDept = mainRow.querySelector('.main-department');
        const collapseDept = collapseRow.querySelector('.collapse-department');
        if (mainDept && collapseDept) {
          const mainText = mainDept.textContent.trim();
          const collapseText = collapseDept.textContent.trim();
          if (mainText === collapseText && mainText !== '') {
            collapseDept.style.setProperty('display', 'none', 'important');
          }
        }
        // Compare placement (only when addPlacementColumn is true)
        const mainPlace = mainRow.querySelector('.main-placement');
        const collapsePlace = collapseRow.querySelector('.collapse-placement');
        if (mainPlace && collapsePlace) {
          const mainText = mainPlace.textContent.trim();
          const collapseText = collapsePlace.textContent.trim();
          if (mainText === collapseText && mainText !== '') {
            collapsePlace.style.setProperty('display', 'none', 'important');
          }
        }
      }
    });
  });
</script>
<?php endif; ?>

