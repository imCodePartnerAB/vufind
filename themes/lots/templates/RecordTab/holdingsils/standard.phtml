<?php
// Render collapse rows for all items with a barcode
if (strlen($holding['barcode'] ?? '') > 0):
?>
  <?php
    $check = $holding['check'] ?? false;
    $checkStorageRetrievalRequest = $holding['checkStorageRetrievalRequest'] ?? false;
    $checkILLRequest = $holding['checkILLRequest'] ?? false;
  ?>
  <tr id="exTr_<?=$iteration?>" class="collapse exGrp_<?=$group ?? 0?>" typeof="Offer" vocab="http://schema.org/">
    <td></td>
    <td>
      <span class="text-muted"><?=$holding["serial_issue_number"] ?? ""?></span>
      <?php if ($holding['reserve'] == "Y"): ?>
        <link property="availability" href="http://schema.org/InStoreOnly" />
        <?=$this->transEsc("On Reserve - Ask at Circulation Desk")?><br />
      <?php endif; ?>
      <?php if ($holding['use_unknown_message'] ?? false): ?>
        <span class="text-muted"><?=$this->transEsc("status_unknown_message")?></span>
      <?php else: ?>
        <?php if ($holding['availability'] ?? false): ?>
          <span class="text-success"><?=$this->transEsc("Available")?><link property="availability" href="http://schema.org/InStock" /></span>
        <?php else: ?>
          <span class="text-danger"><?=$this->transEsc($holding['status'])?><link property="availability" href="http://schema.org/OutOfStock" /></span>
          <?php if ($holding['returnDate'] ?? false): ?>&ndash; <span class="small"><?=$this->escapeHtml($holding['returnDate'])?></span><?php endif; ?>
          <?php if ($holding['duedate'] ?? false): ?>
            &ndash; <span class="small"><?=$this->transEsc("Due")?>: <?=$this->escapeHtml($holding['duedate'])?></span>
          <?php endif; ?>
          <?php if (($holding['requests_placed'] ?? 0) > 0): ?>
            <span><?=$this->transEsc("Requests")?>: <?=$this->escapeHtml($holding['requests_placed'])?></span>
          <?php endif; ?>
        <?php endif; ?>
        <?php /* Action links inside status cell — no extra <td> */ ?>
        <?php if (!($hideReserveButton ?? true) && ($holding['link'] ?? false)): ?>
          <div>
            <?php if ($holding['availability'] ?? false): ?>
              <a class="<?=$check ? 'checkRequest ' : ''?>placehold"
                <?php if (!empty($holding['linkLightbox'])): ?>data-lightbox <?php endif; ?>
                href="<?=$this->escapeHtmlAttr($this->recordLinker()->getRequestUrl($holding['link']))?>">
                <i class="fa fa-flag" aria-hidden="true"></i>&nbsp;<?=$this->transEsc($check ? "Check Hold" : "Place a Hold")?>
              </a>
            <?php else: ?>
              <a class="<?=$check ? 'checkRequest' : ''?> placehold"
                <?php if (!empty($holding['linkLightbox'])): ?>data-lightbox <?php endif; ?>
                href="<?=$this->escapeHtmlAttr($this->recordLinker()->getRequestUrl($holding['link']))?>">
                <i class="fa fa-flag" aria-hidden="true"></i>&nbsp;<?=$this->transEsc($check ? "Check Recall" : "Recall This")?>
              </a>
            <?php endif; ?>
          </div>
        <?php endif; ?>
        <?php if (!($hideReserveButton ?? true) && ($holding['storageRetrievalRequestLink'] ?? false)): ?>
          <div>
            <a class="<?=$checkStorageRetrievalRequest ? 'checkStorageRetrievalRequest ' : ''?>placeStorageRetrievalRequest"
              data-lightbox
              href="<?=$this->escapeHtmlAttr($this->recordLinker()->getRequestUrl($holding['storageRetrievalRequestLink']))?>">
              <i class="fa fa-flag" aria-hidden="true"></i>&nbsp;<?=$this->transEsc($checkStorageRetrievalRequest ? "storage_retrieval_request_check_text" : "storage_retrieval_request_place_text")?>
            </a>
          </div>
        <?php endif; ?>
        <?php if (!($hideReserveButton ?? true) && ($holding['ILLRequestLink'] ?? false)): ?>
          <div>
            <a class="<?=$checkILLRequest ? 'checkILLRequest ' : ''?>placeILLRequest"
              data-lightbox
              href="<?=$this->escapeHtmlAttr($this->recordLinker()->getRequestUrl($holding['ILLRequestLink']))?>">
              <i class="fa fa-flag" aria-hidden="true"></i>&nbsp;<?=$this->transEsc($checkILLRequest ? "ill_request_check_text" : "ill_request_place_text")?>
            </a>
          </div>
        <?php endif; ?>
        <?php if (!($hideReserveButton ?? true) && !($holding['availability'] ?? false)): ?>
          <?=$this->relais()->renderButtonIfActive($this->driver ?? null)?>
        <?php endif; ?>
        <?php if (isset($holding['item_notes'])): ?>
          <div class="item-notes">
            <b><?=$this->transEsc("Item Notes")?>:</b>
            <ul>
              <?php foreach ($holding['item_notes'] as $item_note): ?>
                <li><?=$this->escapeHtml($item_note) ?></li>
              <?php endforeach; ?>
            </ul>
          </div>
        <?php endif; ?>
        <?php /* SEO metadata */ ?>
        <?php if ($holding['location'] ?? false): ?>
          <meta property="seller" content="<?=$this->escapeHtmlAttr($holding['location'])?>" />
        <?php endif; ?>
        <?php if ($holding['barcode'] ?? false): ?>
          <meta property="serialNumber" content="<?=$this->escapeHtmlAttr($holding['barcode'])?>" />
        <?php endif; ?>
        <?php if ($holding['callnumber'] ?? false): ?>
          <meta property="sku" content="<?=$this->escapeHtmlAttr($holding['callnumber'])?>" />
        <?php endif; ?>
        <link property="businessFunction" href="http://purl.org/goodrelations/v1#LeaseOut" />
        <link property="itemOffered" href="#record" />
      <?php endif; ?>
    </td>
    <?php if ($addTypeColumn ?? false): ?>
    <td><?=$this->transEsc($holding['item_type_id'] ?? '')?></td>
    <?php endif; ?>
    <td class="collapse-department">
      <span class="text-muted"><?=$holding["collection_code_description"] ?? ""?></span>
    </td>
    <?php if ($addPlacementColumn ?? false): ?>
    <td class="collapse-placement">
      <span class="text-muted"><?=$holding["callnumber"] ?? ""?><?php if (!empty($holding["location_description"])): ?>, <?=$holding["location_description"]?><?php endif; ?></span>
    </td>
    <?php endif; ?>
  </tr>
<?php
endif;
$iteration+=1;
?>
